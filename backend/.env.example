
# Runtime mode controls the production CORS default.
NODE_ENV=development

# Database connection. Set exactly one URI variable; MONGO_URI remains for
# compatibility with earlier deployments.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_URI=
PORT=5000

# Comma-separated browser origins allowed to call this API. This must be set
# in production, for example: https://app.example.com
CORS_ORIGIN=http://localhost:5173

# OpenAI API key used by the form extraction endpoint; never commit a real key.
OPENAI_API_KEY=your_openai_api_key
# Optional extraction-provider settings.
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000

# Optional base URL for the standalone API smoke-test script.
API_URL=http://localhost:5000/api/forms
