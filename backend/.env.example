
# Database connection. MONGO_URI is also accepted for compatibility with
# existing deployments; set only one of the two variables.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
PORT=5000

# OpenAI API key used by the form extraction endpoint; never commit a real key.
OPENAI_API_KEY=your_openai_api_key
# Optional extraction-provider settings.
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000
